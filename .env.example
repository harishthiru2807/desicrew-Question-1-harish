# DesiCrew AI Data Agent — Configuration Template
# Copy this file to .env and fill in your preferred API key:

# ── OPTION 1: Groq (Recommended & 100% Free — No credit card required) ──────
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key-here

# ── OPTION 2: Google Gemini (Free tier from Google AI Studio) ───────────────
# Get your free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.8-flash

# ── OPTION 3: OpenAI (Paid — Requires account credit balance) ───────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
